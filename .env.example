# 管理页面默认只监听本机。公网部署请使用 HTTPS 反向代理。
HOST=127.0.0.1
PORT=8787

# 数据、附件和登录凭据的保存位置。
DATA_DIR=./data

# 个人版登录会话有效期。首次启动页面会创建唯一的本机账户。
SESSION_DAYS=30
# 部署到公网时填写 HTTPS 地址，例如 https://inbox.example.com
PUBLIC_BASE_URL=

# 只处理这些微信用户 ID，逗号分隔。留空时只允许扫码登录者本人；* 表示允许所有人。
ILINK_ALLOW_FROM=
ILINK_APP_ID=bot
ILINK_BOT_AGENT=WechatInbox/0.1.0
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
ILINK_LONG_POLL_MS=35000
ILINK_MAX_MEDIA_MB=100

# 可选：把每条入站消息交给你的业务服务。
# 业务服务返回 {"reply":"回复内容"} 即可自动回微信；返回 204 或 {} 表示不回复。
PROCESS_WEBHOOK_URL=
PROCESS_WEBHOOK_SECRET=
PROCESS_WEBHOOK_TIMEOUT_MS=30000

# Nanobot 的 OpenAI 兼容接口。Nanobot 未启动时，消息仍会使用内置规则生成笔记并正常同步。
NANOBOT_BASE_URL=http://127.0.0.1:8900/v1/
# 可选。也可以在管理页面保存；环境变量不会被页面显示或写入镜像。
NANOBOT_API_KEY=
# 留空时由 Nanobot 使用它自己的默认模型；也可以填写 /v1/models 返回的准确 ID。
NANOBOT_MODEL=
NANOBOT_TIMEOUT_MS=120000

# 仅在 Clash 等本机代理明确使用 198.18.0.0/15 Fake-IP 时开启；服务器/Docker 保持 false。
WEB_FETCH_ALLOW_BENCHMARK_NETWORK=false

# 单次发送给 Obsidian 的最大消息数。
SYNC_BATCH_SIZE=100

# 未配置业务 Webhook 或业务未返回回复时，是否发送确认消息。
AUTO_ACK=false
AUTO_ACK_TEXT=已收到并保存。
LOG_LEVEL=info
