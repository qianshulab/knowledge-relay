# 源码部署的监听地址和端口。
HOST=127.0.0.1
PORT=8787

# Docker 发布地址。0.0.0.0 允许局域网访问；也可填写宿主机固定 IP 或 127.0.0.1。
KNOWLEDGE_RELAY_BIND_ADDRESS=0.0.0.0
# Docker 镜像版本。生产环境建议固定到 GitHub Releases 中的具体版本。
KNOWLEDGE_RELAY_IMAGE_TAG=latest
KNOWLEDGE_RELAY_BACKUP_DIR=./backups

# 数据、附件和登录凭据的保存位置。
DATA_DIR=./data

# 登录会话有效期。首次启动页面会创建管理员账户，之后可由管理员邀请成员。
SESSION_DAYS=30
# 部署到公网时填写 HTTPS 地址，例如 https://inbox.example.com
PUBLIC_BASE_URL=

# 只处理这些微信用户 ID，逗号分隔。留空时只允许扫码登录者本人；* 表示允许所有人。
ILINK_ALLOW_FROM=
ILINK_APP_ID=bot
ILINK_BOT_AGENT=WechatInbox/0.1.0
ILINK_BASE_URL=https://ilinkai.weixin.qq.com
ILINK_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c
ILINK_LONG_POLL_MS=35000
ILINK_MAX_MEDIA_MB=100

# 可选：把每条入站消息交给你的业务服务。
# 业务服务返回 {"reply":"回复内容"} 即可自动回微信；返回 204 或 {} 表示不回复。
PROCESS_WEBHOOK_URL=
PROCESS_WEBHOOK_SECRET=
PROCESS_WEBHOOK_TIMEOUT_MS=30000

# 知流只调用官方 Nanobot Runtime，不直接调用模型供应商。
NANOBOT_BASE_URL=http://127.0.0.1:8900/v1/
NANOBOT_SEARCH_BASE_URL=http://127.0.0.1:8902/v1/
NANOBOT_CATALOG_URL=http://127.0.0.1:8901/
# 本机 loopback 可留空；Docker 内部 Runtime 必须设置独立鉴权 Key。
NANOBOT_API_KEY=
NANOBOT_RUNTIME_API_KEY=请替换为随机长字符串
NANOBOT_MANAGED=true
NANOBOT_AUTO_RELOAD=true
NANOBOT_CONFIG=./data/nanobot/config.json
NANOBOT_WORKSPACE=./data/nanobot/workspace
NANOBOT_TIMEOUT_MS=120000
# 完整整理任务连续无新 Agent 步骤 15 分钟才判定停滞；持续有进展时最长等待 6 小时。
NANOBOT_PROCESS_IDLE_TIMEOUT_MS=900000
NANOBOT_PROCESS_MAX_TIMEOUT_MS=21600000
# Runtime 的灾难性上限应高于知流的最大等待时间。
NANOBOT_SERVE_TIMEOUT=28800
# 每个活跃用户使用独立 Runtime；空闲实例会自动退出，工作区和数据仍会保留。
NANOBOT_MAX_TENANT_RUNTIMES=12
NANOBOT_TENANT_IDLE_MS=1800000

# 可选：预配置默认 DeepSeek；也可以启动后在后台配置 Nanobot 提供者。
DEEPSEEK_API_KEY=

# 单次发送给 Obsidian 的最大消息数。
SYNC_BATCH_SIZE=100

# 未配置业务 Webhook 或业务未返回回复时，是否发送确认消息。
AUTO_ACK=false
AUTO_ACK_TEXT=已收到并保存。
LOG_LEVEL=info
