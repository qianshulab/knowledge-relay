{
  "name": "knowledge-relay",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Self-hosted WeChat iLink capture, safe web parsing, AI processing, and Obsidian sync.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "package:plugin": "node scripts/package-plugin.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build && node --check obsidian-plugin/main.js && node --test obsidian-plugin/template.verify.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/qrcode": "^1.5.5",
    "@types/turndown": "^5.0.6",
    "adm-zip": "^0.6.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
